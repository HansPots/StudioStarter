<Window x:Class="StudioStarter.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Studio • Jouw werkruimte" Width="1180" Height="800" MinWidth="900" MinHeight="650" Background="#0D1422" Foreground="#DFE7F5" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
 <Style TargetType="TabItem">
  <Setter Property="Foreground" Value="#9AABC3"/><Setter Property="Background" Value="#18243A"/><Setter Property="Padding" Value="20,12"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#C5F277"/><Setter TargetName="Chrome" Property="Background" Value="#263B3A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</Window.Resources>
 <Grid Margin="30" Background="#0D1422">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,25"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}"><Button Content="Exporteren" Command="{Binding ExportCommand}"/><Button Content="Opslaan   Ctrl+S" Command="{Binding SaveCommand}"/></StackPanel><StackPanel><TextBlock Text="STUDIO / STARTER" Foreground="#C5F277" FontWeight="Bold" FontSize="12"/><TextBlock Text="Jouw ideeën. Jouw werkruimte." FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></DockPanel>
  <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Background="#121D30" BorderThickness="0" Padding="24" IsEnabled="{Binding IsIdle}">
   <TabItem Header="Overzicht"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="#213C38" CornerRadius="14" Padding="26" Margin="0,0,0,22"><StackPanel><TextBlock Text="{Binding Greeting}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Een frisse start voor wat jij wilt bouwen." Foreground="#B7D5C9" Margin="0,8,0,18"/><TextBlock Text="Begin klein. Maak een taak, schrijf een idee en maak deze app helemaal van jou." TextWrapping="Wrap"/></StackPanel></Border>
    <UniformGrid Columns="3" Margin="0,0,0,24">
     <Border Background="#1B2940" CornerRadius="10" Padding="22" Margin="0,0,12,0"><StackPanel><TextBlock Text="TOTAAL TAKEN" Foreground="#93A3BA"/><TextBlock Text="{Binding TotalCount}" FontSize="40" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Background="#1B2940" CornerRadius="10" Padding="22" Margin="0,0,12,0"><StackPanel><TextBlock Text="NOG TE DOEN" Foreground="#93A3BA"/><TextBlock Text="{Binding OpenCount}" FontSize="40" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Background="#1B2940" CornerRadius="10" Padding="22"><StackPanel><TextBlock Text="AFGEROND" Foreground="#93A3BA"/><TextBlock Text="{Binding DoneCount}" FontSize="40" Foreground="#C5F277" FontWeight="SemiBold"/></StackPanel></Border>
    </UniformGrid>
    <TextBlock Text="Jouw voortgang" FontSize="20" FontWeight="SemiBold"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="10" Foreground="#C5F277" Background="#26344B" BorderThickness="0" Margin="0,15,0,8"/><TextBlock Text="{Binding Progress, StringFormat={}{0:F0}% afgerond}" Foreground="#93A3BA"/>
    <Border BorderBrush="#34425B" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,26,0,0"><StackPanel><TextBlock Text="Ruimte voor jouw volgende idee" FontSize="20"/><TextBlock Text="Taken, notities en instellingen vormen het begin. Breid de app uit met een projectplanner, eigen API, rapportages of een compleet nieuwe module." TextWrapping="Wrap" Foreground="#93A3BA" Margin="0,10,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Taken"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Maak ruimte voor focus" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Voeg taken toe, zoek ze op en vink af wat klaar is." Foreground="#93A3BA" Margin="0,8,0,16"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="Nieuwe taak"/><DockPanel><Button DockPanel.Dock="Right" Content="Toevoegen +" Command="{Binding AddTaskCommand}" VerticalAlignment="Top" Margin="10,5,0,0"/><TextBox Text="{Binding NewTask, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddTaskCommand}"/></TextBox.InputBindings></TextBox></DockPanel><TextBlock Text="Zoeken"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredTasks}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><Border Background="#1B2940" CornerRadius="8" Padding="14" Margin="0,0,0,8"><DockPanel><Button DockPanel.Dock="Right" Content="Verwijder" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#34425B" Foreground="White"/><CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" Foreground="#E2E9F6"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="8,0"/></CheckBox></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid></TabItem>
   <TabItem Header="Notities"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Een plek voor losse ideeën" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Vrije tekst voor plannen, schetsen en alles wat je wilt onthouden." Foreground="#93A3BA" Margin="0,8,0,20"/></StackPanel><TextBox Grid.Row="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="16"/></Grid></TabItem>
   <TabItem Header="Instellingen"><StackPanel><TextBlock Text="Maak het persoonlijk" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Jouw naam" Margin="0,24,0,0"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/><TextBlock Text="Gegevensopslag" FontSize="20" Margin="0,24,0,10"/><TextBlock Text="Je werkruimte blijft op deze computer. Klik op Opslaan om wijzigingen te bewaren. Met Exporteren maak je een leesbare JSON-kopie." TextWrapping="Wrap" Foreground="#93A3BA"/><TextBlock Text="Opgeslagen in: %LocalAppData%\StudioStarter" Foreground="#93A3BA" Margin="0,12,0,0"/><TextBlock Text="Gemaakt om uit te breiden" FontSize="20" Margin="0,30,0,10"/><TextBlock Text="WPF / .NET 10 • MVVM • Dependency injection • Logging&#10;Gescheiden projecten voor interface, domein en opslag." Foreground="#93A3BA" TextWrapping="Wrap"/></StackPanel></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding SaveLabel}" Foreground="#93A3BA"/><TextBlock Text="{Binding Status}" Foreground="#C5F277" TextWrapping="Wrap"/></DockPanel>
 </Grid>
 <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/></Window.InputBindings>
</Window>
