<Application x:Class="StudioStarter.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#19243A"/><Setter Property="Foreground" Value="#F2F6FF"/><Setter Property="BorderBrush" Value="#34425B"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#C5F277"/><Setter Property="Foreground" Value="#142020"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
  </Application.Resources>
</Application>
